# URL de base de l'API Django REST consommée par le poste de pilotage
VITE_API_BASE_URL=http://localhost:8000/api

# Adaptateur de simulation : « true » intercepte les appels avec des données de démonstration,
# « false » cible l'API réelle. Le basculement ne modifie aucun composant.
VITE_USE_MOCKS=true
