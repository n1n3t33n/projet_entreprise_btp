# Variables d'environnement du backend ChantierSync.
# Copier en « .env » (jamais committé) et renseigner. Aucune valeur secrète ici.
# En production (PaaS), ces variables sont saisies dans la console de la
# plateforme : aucun fichier n'est lu.

# --- Django ---
DJANGO_SETTINGS_MODULE=configuration.reglages.developpement
DJANGO_SECRET_KEY=
DJANGO_HOTES_AUTORISES=localhost,127.0.0.1
# Origines du poste de pilotage web autorisées par CORS (Vite : port 5173).
CORS_ORIGINES_AUTORISEES=http://localhost:5173

# --- Base PostgreSQL 16 (commune aux deux connexions) ---
DB_NOM=chantiersync_dev
DB_HOTE=127.0.0.1
DB_PORT=5432

# Connexion d'exécution : rôle applicatif, NON propriétaire des tables
# (immuabilité RG-S8, rapport B0 § 4.4).
DB_UTILISATEUR=chantiersync_application
DB_MOT_DE_PASSE=

# Connexion des migrations (« manage.py migrate --database migration ») :
# rôle de migration, qui agit sous le rôle propriétaire.
DB_MIGRATION_UTILISATEUR=chantiersync_migration
DB_MIGRATION_MOT_DE_PASSE=
DB_MIGRATION_ROLE=chantiersync_proprietaire

# Noms des rôles PostgreSQL utilisés par les migrations pour poser les droits.
BD_ROLE_APPLICATION=chantiersync_application
BD_ROLE_PROPRIETAIRE=chantiersync_proprietaire

# --- Jetons (rapport B0 § 6.3, arbitrage Q2) ---
JETON_DUREE_MOBILE_JOURS=14
JETON_DUREE_WEB_HEURES=8
JETON_RENOUVELLEMENT_HEURES=24

# --- Limitation du taux (exigence 6.3) ---
LIMITE_CONNEXION_IP=20/min
LIMITE_CONNEXION_IDENTIFIANT=10/min
LIMITE_UTILISATEUR=600/min
LIMITE_ANONYME=60/min
# Nombre de mandataires inverses devant l'application (0 en local).
NOMBRE_MANDATAIRES=0

# --- Partitions mensuelles des journaux ---
PARTITIONS_MOIS_AVANCE=3

# --- Journaux ---
NIVEAU_JOURNAL=INFO

# --- Données de démonstration (commande « charger_demo » uniquement) ---
DEMO_MOT_DE_PASSE=
