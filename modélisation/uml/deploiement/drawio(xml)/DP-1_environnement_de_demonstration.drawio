    </mxCell>
    <mxCell id="n44" parent="n36" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#333333;fontFamily=Helvetica;" value="Trait épais = chemin de communication" vertex="1">
      <mxGeometry height="16" width="414" x="38" y="92" as="geometry" />
    </mxCell>
    <mxCell id="n45" parent="1" style="shape=note;whiteSpace=wrap;html=1;size=14;fillColor=#FFFDE7;strokeColor=#B8A000;fontSize=11;fontColor=#4A3F00;align=left;verticalAlign=top;fontFamily=Helvetica;spacingLeft=6;spacingTop=2;spacingRight=6;" value="Critère de passage (§ 13.4) : le pilote réel ne démarre que si le cahier des charges est validé, si l&#39;accord écrit sur les données et l&#39;hébergement est obtenu, si le catalogue est importé, si un magasinier est désigné et si l&#39;état de référence a été relevé. Ce diagramme n&#39;est donc exécutable qu&#39;une fois ces cinq conditions réunies — aucune d&#39;elles ne l&#39;est au 20 octobre 2026." vertex="1">
      <mxGeometry height="130" width="500" x="60" y="1000" as="geometry" />
    </mxCell>
  </root>
